{
  "version": 1,
  "template": "single",
  "metadata": { "roleContract": 1 },
  "root": { "props": {} },
  "content": [
    {
      "type": "Section",
      "props": {
        "id": "ind-single-main-section",
        "containerWidth": "containerWidth",
        "verticalPadding": "lg",
        "minHeight": "auto"
      }
    }
  ],
  "zones": {
    "ind-single-main-section:content": [
      {
        "type": "Columns",
        "props": {
          "id": "ind-single-layout",
          "distribution": "2:1",
          "gap": "36px"
        }
      }
    ],
    "ind-single-layout:column1": [
      {
        "type": "Heading",
        "props": {
          "id": "ind-single-title",
          "text": "",
          "tag": "h1",
          "textBinding": "title",
          "lock": { "canDelete": false, "canMove": false, "canEditProps": true }
        }
      },
      {
        "type": "Text",
        "props": { "id": "ind-single-date", "text": "", "textBinding": "date" }
      },
      {
        "type": "Text",
        "props": { "id": "ind-single-taxonomy", "text": "", "textBinding": "taxonomy" }
      },
      {
        "type": "Image",
        "props": {
          "id": "ind-single-media",
          "src": "",
          "alt": "",
          "srcBinding": "thumbnail",
          "aspectRatio": "16:9",
          "objectFit": "cover"
        }
      },
      {
        "type": "PostContent",
        "props": {
          "id": "ind-single-content",
          "showExcerpt": false,
          "lock": { "canDelete": false, "canMove": false, "canEditProps": true }
        }
      }
    ],
    "ind-single-layout:column2": [
      {
        "type": "TextBlock",
        "props": {
          "id": "ind-single-sidebar",
          "title": "THÔNG TIN KỸ THUẬT & DỰ ÁN",
          "content": "Quý khách có nhu cầu khảo sát thực tế nhà máy hoặc nhận bảng dự toán kỹ thuật chi tiết, vui lòng gửi yêu cầu đến ban điều hành sản xuất.\n\nHotline: 1900.6868\nEmail: engineering@zyvavu-industrial.vn"
        }
      }
    ]
  }
}
