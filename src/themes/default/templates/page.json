{
  "version": 1,
  "template": "page",
  "root": {
    "props": {}
  },
  "content": [
    {
      "type": "Section",
      "props": {
        "id": "corp-page-header-section",
        "containerWidth": "narrowWidth",
        "verticalPadding": "md",
        "minHeight": "auto"
      }
    },
    {
      "type": "Section",
      "props": {
        "id": "corp-page-body-section",
        "containerWidth": "narrowWidth",
        "verticalPadding": "lg",
        "minHeight": "auto"
      }
    }
  ],
  "zones": {
    "corp-page-header-section:content": [
      {
        "type": "PostTitle",
        "props": {
          "id": "page-title-1",
          "tag": "h1",
          "align": "left",
          "variant": "default",
          "lock": {
            "canDelete": false,
            "canMove": true,
            "canEditProps": true
          }
        }
      }
    ],
    "corp-page-body-section:content": [
      {
        "type": "PostContent",
        "props": {
          "id": "page-content-1",
          "showExcerptFirst": false,
          "lock": {
            "canDelete": false,
            "canMove": false,
            "canEditProps": true
          }
        }
      }
    ]
  }
}
