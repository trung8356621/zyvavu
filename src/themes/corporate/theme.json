{
  "name": "corporate",
  "version": 1,
  "label": "Corporate Clean",
  "description": "Modern clean B2B theme with light header, teal branding, and structured content sections.",
  "tokens": {
    "colors": {
      "primary": "#0e6b66",
      "primaryHover": "#0b5652",
      "background": "#ffffff",
      "surface": "#f8faf9",
      "text": "#17201f",
      "textMuted": "#5f7370",
      "border": "#dfe5e2",
      "accent": "#2b8a7f",
      "shadowSoft": "#e6eceb",
      "shadowMedium": "#bfd0cd",
      "shadowStrong": "#7a9692",
      "headerBackground": "#ffffff",
      "headerText": "#17201f",
      "headerBorder": "#dfe5e2"
    },
    "typography": {
      "fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
      "fontFamilyHeading": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
      "baseFontSize": "18px",
      "baseLineHeight": "1.75",
      "h1": {
        "size": "44px",
        "lineHeight": "1.2",
        "weight": "700"
      },
      "h2": {
        "size": "32px",
        "lineHeight": "1.3",
        "weight": "600"
      },
      "h3": {
        "size": "24px",
        "lineHeight": "1.4",
        "weight": "600"
      },
      "h4": {
        "size": "20px",
        "lineHeight": "1.4",
        "weight": "600"
      },
      "h5": {
        "size": "16px",
        "lineHeight": "1.5",
        "weight": "600"
      },
      "h6": {
        "size": "14px",
        "lineHeight": "1.5",
        "weight": "600"
      },
      "p1": {
        "size": "20px",
        "lineHeight": "1.6",
        "weight": "400"
      },
      "p2": {
        "size": "16px",
        "lineHeight": "1.65",
        "weight": "400"
      },
      "p3": {
        "size": "14px",
        "lineHeight": "1.6",
        "weight": "400"
      }
    },
    "spacing": {
      "xs": "4px",
      "sm": "8px",
      "md": "16px",
      "lg": "24px",
      "xl": "40px",
      "xxl": "64px"
    },
    "layout": {
      "containerWidth": "1200px",
      "narrowWidth": "800px",
      "wideWidth": "1400px",
      "alignment": "left",
      "pageSpacing": "md"
    },
    "radius": {
      "sm": "4px",
      "md": "8px",
      "lg": "12px",
      "pill": "9999px"
    }
  },
  "slots": {
    "PostTitle": {
      "root": "margin-bottom: 1.5rem;",
      "title": "color: var(--zyvavu-theme-text, inherit); letter-spacing: -0.02em;"
    },
    "PostContent": {
      "root": "line-height: 1.8; color: var(--zyvavu-theme-text, inherit);",
      "body": "margin-bottom: 1.5rem;"
    },
    "Header": {
      "topBar": "background: var(--zyvavu-theme-surface, #f8faf9); font-size: 13px; border-bottom: 1px solid var(--zyvavu-theme-border, #dfe5e2);",
      "mainHeader": "background: var(--zyvavu-theme-header-background, #ffffff); border-bottom: 1px solid var(--zyvavu-theme-header-border, #dfe5e2);"
    },
    "Footer": {
      "root": "background: var(--zyvavu-theme-surface, #f8faf9); border-top: 1px solid var(--zyvavu-theme-border, #dfe5e2); padding: 48px 0 24px;"
    }
  }
}
