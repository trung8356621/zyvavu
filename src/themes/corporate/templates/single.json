{
  "version": 1,
  "template": "single",
  "root": {
    "props": {}
  },
  "content": [
    {
      "type": "PostTitle",
      "props": {
        "id": "single-title-1",
        "tag": "h1",
        "align": "left",
        "variant": "default",
        "lock": {
          "canDelete": false,
          "canMove": true,
          "canEditProps": true
        }
      }
    },
    {
      "type": "PostMeta",
      "props": {
        "id": "single-meta-1",
        "showDate": true,
        "showAuthor": true,
        "showCategories": true
      }
    },
    {
      "type": "FeaturedMedia",
      "props": {
        "id": "single-media-1",
        "aspectRatio": "16:9",
        "rounded": true
      }
    },
    {
      "type": "PostContent",
      "props": {
        "id": "single-content-1",
        "showExcerptFirst": true,
        "lock": {
          "canDelete": false,
          "canMove": false,
          "canEditProps": true
        }
      }
    }
  ],
  "zones": {}
}
