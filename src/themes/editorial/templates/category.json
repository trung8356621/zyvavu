{
  "version": 1,
  "template": "category",
  "root": {
    "props": {}
  },
  "content": [
    {
      "type": "Section",
      "props": {
        "id": "edit-cat-header-section",
        "containerWidth": "containerWidth",
        "verticalPadding": "md",
        "minHeight": "auto"
      }
    },
    {
      "type": "Section",
      "props": {
        "id": "edit-cat-posts-section",
        "containerWidth": "containerWidth",
        "verticalPadding": "lg",
        "minHeight": "auto"
      }
    }
  ],
  "zones": {
    "edit-cat-header-section:content": [
      {
        "type": "CategoryHeader",
        "props": {
          "id": "edit-cat-header",
          "align": "center",
          "showCount": true,
          "lock": {
            "canDelete": false,
            "canMove": false,
            "canEditProps": true
          }
        }
      }
    ],
    "edit-cat-posts-section:content": [
      {
        "type": "RecentPosts",
        "props": {
          "id": "edit-cat-posts",
          "heading": "CÁC BÀI VIẾT ĐÃ XUẤT BẢN TRONG CHUYÊN MỤC",
          "limit": 6,
          "showDate": true,
          "showExcerpt": true,
          "layout": "grid"
        }
      }
    ]
  }
}
