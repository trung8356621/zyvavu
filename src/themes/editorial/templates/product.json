{
  "version": 1,
  "template": "product",
  "root": {
    "props": {}
  },
  "content": [
    {
      "type": "Section",
      "props": {
        "id": "edit-product-header-section",
        "containerWidth": "containerWidth",
        "verticalPadding": "lg",
        "minHeight": "auto"
      }
    },
    {
      "type": "Section",
      "props": {
        "id": "edit-product-body-section",
        "containerWidth": "narrowWidth",
        "verticalPadding": "md",
        "minHeight": "auto"
      }
    }
  ],
  "zones": {
    "edit-product-header-section:content": [
      {
        "type": "ProductHeader",
        "props": {
          "id": "edit-product-header",
          "showPrice": true,
          "showVariants": true,
          "showPurchase": true,
          "lock": {
            "canDelete": false,
            "canMove": false,
            "canEditProps": true
          }
        }
      }
    ],
    "edit-product-body-section:content": [
      {
        "type": "TextBlock",
        "props": {
          "id": "edit-product-content",
          "title": "Mô tả ấn phẩm & Quy cách lưu hành",
          "content": "Các ấn bản sách và tài liệu nghiên cứu học thuật được phát hành định kỳ với số lượng giới hạn theo tiêu chuẩn in ấn mỹ thuật đặc biệt.",
          "lock": {
            "canDelete": false,
            "canMove": false,
            "canEditProps": true
          }
        }
      }
    ]
  }
}
