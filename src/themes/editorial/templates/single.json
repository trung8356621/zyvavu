{
  "version": 1,
  "template": "single",
  "metadata": { "roleContract": 1 },
  "root": { "props": {} },
  "content": [
    {
      "type": "Section",
      "props": {
        "id": "edit-single-header-section",
        "containerWidth": "narrowWidth",
        "verticalPadding": "md",
        "minHeight": "auto"
      }
    },
    {
      "type": "Section",
      "props": {
        "id": "edit-single-media-section",
        "containerWidth": "containerWidth",
        "verticalPadding": "sm",
        "minHeight": "auto"
      }
    },
    {
      "type": "Section",
      "props": {
        "id": "edit-single-body-section",
        "containerWidth": "narrowWidth",
        "verticalPadding": "lg",
        "minHeight": "auto"
      }
    }
  ],
  "zones": {
    "edit-single-header-section:content": [
      {
        "type": "Heading",
        "props": {
          "id": "edit-single-title",
          "text": "",
          "tag": "h1",
          "textBinding": "title",
          "lock": { "canDelete": false, "canMove": false, "canEditProps": true }
        }
      },
      {
        "type": "Text",
        "props": { "id": "edit-single-date", "text": "", "textBinding": "date" }
      },
      {
        "type": "Text",
        "props": { "id": "edit-single-taxonomy", "text": "", "textBinding": "taxonomy" }
      }
    ],
    "edit-single-media-section:content": [
      {
        "type": "Image",
        "props": {
          "id": "edit-single-media",
          "src": "",
          "alt": "",
          "srcBinding": "thumbnail",
          "aspectRatio": "16:9",
          "objectFit": "cover"
        }
      }
    ],
    "edit-single-body-section:content": [
      {
        "type": "PostContent",
        "props": {
          "id": "edit-single-content",
          "showExcerpt": false,
          "lock": { "canDelete": false, "canMove": false, "canEditProps": true }
        }
      }
    ]
  }
}
