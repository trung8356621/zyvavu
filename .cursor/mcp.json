{
  "mcpServers": {
    "cms-knowledge": {
      "command": "node",
      "args": ["D:/zyvavu/cms-knowledge-pack/mcp/server.mjs"],
      "env": {
        "CMS_KNOWLEDGE_ROOT": "D:\\zyvavu\\cms-knowledge-pack"
      }
    },
    "chrome-devtools": {
      "command": "node",
      "args": [
        "${workspaceFolder}/node_modules/chrome-devtools-mcp/build/src/bin/chrome-devtools-mcp.js",
        "--isolated",
        "--no-usage-statistics",
        "--no-performance-crux"
      ],
      "env": {
        "CHROME_DEVTOOLS_MCP_NO_USAGE_STATISTICS": "1"
      }
    }
  }
}
